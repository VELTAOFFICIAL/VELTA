<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VELTA — Честный смартфон</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #080808;
    --bg2: #0d0d0d;
    --bg3: #111111;
    --surface: #161616;
    --surface2: #1c1c1c;
    --accent: #b8ff57;
    --accent2: #00e5ff;
    --accent-dim: rgba(184,255,87,0.12);
    --accent2-dim: rgba(0,229,255,0.10);
    --text: #f0f0f0;
    --text-muted: #777;
    --text-dim: #444;
    --border: rgba(255,255,255,0.07);
    --border-accent: rgba(184,255,87,0.25);
    --font-display: 'Syne', sans-serif;
    --font-body: 'DM Sans', sans-serif;
    --r: 16px;
    --r-lg: 24px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-weight: 300;
    line-height: 1.6;
    overflow-x: hidden;
    cursor: none;
  }

  /* CUSTOM CURSOR */
  .cursor {
    position: fixed; top: 0; left: 0; z-index: 9999;
    pointer-events: none;
    mix-blend-mode: difference;
  }
  .cursor-dot {
    width: 8px; height: 8px;
    background: var(--accent);
    border-radius: 50%;
    transform: translate(-50%,-50%);
    transition: transform 0.1s;
  }
  .cursor-ring {
    position: fixed; top: 0; left: 0; z-index: 9998;
    width: 36px; height: 36px;
    border: 1px solid rgba(184,255,87,0.5);
    border-radius: 50%;
    transform: translate(-50%,-50%);
    pointer-events: none;
    transition: width 0.3s, height 0.3s, border-color 0.3s, transform 0.08s;
  }
  body:has(a:hover) .cursor-ring,
  body:has(button:hover) .cursor-ring {
    width: 52px; height: 52px;
    border-color: var(--accent);
  }

  /* NOISE TEXTURE OVERLAY */
  body::before {
    content: '';
    position: fixed; inset: 0; z-index: 0;
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 200px;
    pointer-events: none;
  }

  /* SCROLLBAR */
  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 2px; }

  /* TYPOGRAPHY */
  h1, h2, h3, h4 { font-family: var(--font-display); line-height: 1.1; letter-spacing: -0.02em; }

  /* HEADER */
  header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    padding: 20px 40px;
    display: flex; align-items: center; justify-content: space-between;
    background: rgba(8,8,8,0.7);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    transition: padding 0.3s;
  }
  header.scrolled { padding: 14px 40px; }

  .logo {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--text);
    text-decoration: none;
    position: relative;
  }
  .logo span { color: var(--accent); }
  .logo::after {
    content: '';
    position: absolute; bottom: -2px; left: 0; right: 0; height: 1px;
    background: var(--accent);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.3s;
  }
  .logo:hover::after { transform: scaleX(1); }

  nav { display: flex; align-items: center; gap: 36px; }
  nav a {
    font-size: 13px; font-weight: 400; letter-spacing: 0.05em;color: var(--text-muted); text-decoration: none; text-transform: uppercase;
    transition: color 0.25s;
    position: relative;
  }
  nav a::after {
    content: '';
    position: absolute; bottom: -3px; left: 0; right: 0; height: 1px;
    background: var(--accent);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.3s;
  }
  nav a:hover { color: var(--text); }
  nav a:hover::after { transform: scaleX(1); }

  .btn {
    font-family: var(--font-display);
    font-size: 13px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    border: none; cursor: none;
    border-radius: 100px;
    transition: all 0.3s;
    text-decoration: none;
    display: inline-flex; align-items: center; gap: 8px;
  }
  .btn-primary {
    background: var(--accent);
    color: #000;
    padding: 11px 24px;
  }
  .btn-primary:hover {
    background: #fff;
    transform: translateY(-2px);
    box-shadow: 0 0 30px rgba(184,255,87,0.4);
  }
  .btn-ghost {
    background: transparent;
    color: var(--text);
    padding: 11px 24px;
    border: 1px solid var(--border);
  }
  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }
  .btn-lg {
    font-size: 15px;
    padding: 16px 36px;
  }

  /* SECTION BASE */
  section { position: relative; z-index: 1; }

  /* HERO */
  #hero {
    min-height: 100vh;
    display: flex; flex-direction: column; justify-content: center;
    padding: 120px 40px 80px;
    overflow: hidden;
  }
  .hero-bg-grid {
    position: absolute; inset: 0; z-index: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black 30%, transparent 100%);
  }
  .hero-glow {
    position: absolute; top: 20%; left: 50%;
    transform: translate(-50%, -50%);
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(184,255,87,0.08) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-glow-blue {
    position: absolute; top: 60%; right: 10%;
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(0,229,255,0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-content { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; width: 100%; }
  .hero-tag {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--accent-dim);
    border: 1px solid var(--border-accent);
    border-radius: 100px;
    padding: 6px 14px;
    font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent); font-weight: 500;
    margin-bottom: 32px;
    animation: fadeUp 0.8s 0.2s both;
  }
  .hero-tag-dot { width: 6px; height: 6px; background: var(--accent); border-radius: 50%; animation: pulse 2s infinite; }

  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }

  .hero-title {
    font-size: clamp(52px, 9vw, 130px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin-bottom: 28px;
    animation: fadeUp 0.8s 0.35s both;
  }
  .hero-title .line2 { color: var(--accent); display: block; }
  .hero-title .line3 {
    -webkit-text-stroke: 1px rgba(255,255,255,0.2);
    color: transparent;
    display: block;
  }

  .hero-sub {
    font-size: clamp(16px, 2vw, 20px);
    color: var(--text-muted);
    max-width: 480px;
    font-weight: 300;
    margin-bottom: 48px;
    animation: fadeUp 0.8s 0.5s both;
  }
  .hero-sub strong { color: var(--text); font-weight: 500; }

  .hero-cta { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 80px; animation: fadeUp 0.8s 0.65s both; }

  .hero-phone-wrapper {position: absolute; right: 5%; top: 50%;
    transform: translateY(-50%);
    width: min(400px, 35vw);
    animation: fadeUp 0.8s 0.4s both, float 6s ease-in-out infinite;
  }
  @keyframes float { 0%,100% { transform: translateY(-50%) translateY(0); } 50% { transform: translateY(-50%) translateY(-20px); } }

  .phone-placeholder {
    width: 100%; aspect-ratio: 9/18;
    border-radius: 40px;
    border: 1px solid rgba(255,255,255,0.1);
    background: linear-gradient(135deg, #1a1a1a 0%, #0d0d0d 50%, #111 100%);
    position: relative;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(184,255,87,0.1),
      0 40px 80px rgba(0,0,0,0.8),
      inset 0 1px 0 rgba(255,255,255,0.08);
  }
  .phone-placeholder::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(184,255,87,0.05) 0%, transparent 50%, rgba(0,229,255,0.05) 100%);
  }
  .phone-placeholder::after {
    content: 'VRERU LITE';
    position: absolute; bottom: 40px; left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-size: 11px; letter-spacing: 0.25em;
    color: rgba(255,255,255,0.15);
  }
  .phone-notch {
    position: absolute; top: 16px; left: 50%; transform: translateX(-50%);
    width: 80px; height: 8px; background: #000;
    border-radius: 100px;
    box-shadow: 0 0 0 1px rgba(255,255,255,0.05);
  }
  .phone-screen-glow {
    position: absolute; top: 30%; left: 50%;
    transform: translate(-50%, -50%);
    width: 120%; height: 60%;
    background: radial-gradient(ellipse, rgba(184,255,87,0.08) 0%, transparent 70%);
  }
  .phone-lines {
    position: absolute; inset: 0;
    background-image: repeating-linear-gradient(0deg, transparent, transparent 30px, rgba(255,255,255,0.015) 31px);
  }

  .hero-stats {
    display: flex; gap: 48px; flex-wrap: wrap;
    animation: fadeUp 0.8s 0.8s both;
  }
  .stat { }
  .stat-num {
    font-family: var(--font-display);
    font-size: 32px; font-weight: 700;
    color: var(--text);
    line-height: 1;
  }
  .stat-num span { color: var(--accent); }
  .stat-label { font-size: 12px; color: var(--text-muted); letter-spacing: 0.05em; margin-top: 4px; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* SECTION STYLES */
  .section-wrap { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
  .section-label {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--accent); font-weight: 500;
    margin-bottom: 20px;
  }
  .section-label::before {
    content: '';
    width: 30px; height: 1px; background: var(--accent);
  }
  .section-title {
    font-size: clamp(32px, 5vw, 60px);
    font-weight: 700; letter-spacing: -0.03em;
    margin-bottom: 16px;
  }

  /* PRICE CALCULATOR */
  #price {
    padding: 120px 0;
    background: linear-gradient(180deg, var(--bg) 0%, var(--bg2) 50%, var(--bg) 100%);
  }
  .price-header { margin-bottom: 60px; }
  .price-subtitle { font-size: 17px; color: var(--text-muted); max-width: 500px; font-weight: 300; }

  .price-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
  }

  .cost-list { display: flex; flex-direction: column; gap: 4px; }
  .cost-item {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 24px;
    border-radius: var(--r);
    border: 1px solid var(--border);
    background: var(--surface);
    position: relative; overflow: hidden;
    transition: all 0.3s;
    cursor: default;
  }
  .cost-item::before {
    content: '';
    position: absolute; left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--accent);
    transform: scaleY(0); transform-origin: bottom;transition: transform 0.3s;
  }
  .cost-item::after {
    content: '';
    position: absolute; inset: 0;
    background: var(--accent-dim);
    opacity: 0; transition: opacity 0.3s;
  }
  .cost-item:hover { border-color: var(--border-accent); transform: translateX(4px); }
  .cost-item:hover::before { transform: scaleY(1); }
  .cost-item:hover::after { opacity: 1; }
  .cost-item:hover .cost-name { color: var(--text); }

  .cost-name {
    font-size: 15px; color: var(--text-muted);
    transition: color 0.3s;
    position: relative; z-index: 1;
    display: flex; align-items: center; gap: 10px;
  }
  .cost-icon { font-size: 18px; }
  .cost-value {
    font-family: var(--font-display);
    font-size: 15px; font-weight: 600;
    color: var(--text);
    position: relative; z-index: 1;
  }

  .cost-divider { height: 1px; background: var(--border); margin: 12px 0; }

  .cost-item.total {
    background: var(--surface2);
    border-color: rgba(255,255,255,0.1);
  }
  .cost-item.total .cost-name { color: var(--text); font-weight: 500; }
  .cost-item.total .cost-value { color: var(--accent); font-size: 18px; }

  .cost-item.markup {
    border-color: rgba(0,229,255,0.15);
    background: rgba(0,229,255,0.04);
  }
  .cost-item.markup .cost-value { color: var(--accent2); }
  .cost-item.markup::before { background: var(--accent2); }

  .cost-item.final-price {
    background: linear-gradient(135deg, rgba(184,255,87,0.1) 0%, rgba(0,229,255,0.05) 100%);
    border-color: var(--border-accent);
    padding: 24px;
  }
  .cost-item.final-price .cost-name { font-size: 17px; color: var(--text); font-weight: 600; }
  .cost-item.final-price .cost-value { font-size: 28px; color: var(--accent); }

  .price-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 40px;
    position: sticky; top: 100px;
  }
  .price-card-title {
    font-family: var(--font-display);
    font-size: 14px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--text-muted); margin-bottom: 32px;
  }

  .vs-container {
    display: flex; flex-direction: column; gap: 20px;
    margin-bottom: 32px;
  }
  .vs-bar-label {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 8px;
  }
  .vs-brand { font-size: 13px; color: var(--text-muted); }
  .vs-price { font-family: var(--font-display); font-size: 16px; font-weight: 700; }
  .vs-price.ours { color: var(--accent); }
  .vs-price.theirs { color: var(--text-muted); text-decoration: line-through; }

  .bar-track {
    height: 8px; background: var(--bg);
    border-radius: 4px; overflow: hidden;
  }
  .bar-fill {
    height: 100%; border-radius: 4px;
    animation: barGrow 1.5s 0.5s both;
    transform-origin: left;
  }
  .bar-fill.ours { background: linear-gradient(90deg, var(--accent), #8aff00); width: 66.7%; }
  .bar-fill.theirs { background: rgba(255,255,255,0.2); width: 100%; }
  @keyframes barGrow { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .savings-badge {
    background: linear-gradient(135deg, var(--accent-dim), rgba(0,229,255,0.08));
    border: 1px solid var(--border-accent);
    border-radius: var(--r);
    padding: 20px 24px;
    text-align: center;
  }
  .savings-num {
    font-family: var(--font-display);
    font-size: 42px; font-weight: 800;
    color: var(--accent);
    line-height: 1;
  }
  .savings-text { font-size: 13px; color: var(--text-muted); margin-top: 6px; }

  /* SPECS */
  #specs { padding: 120px 0; }
  .specs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-top: 60px;
  }
  .spec-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 36px;transition: all 0.4s;
    position: relative; overflow: hidden;
    cursor: default;
  }
  .spec-card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0; transition: opacity 0.4s;
  }
  .spec-card::after {
    content: '';
    position: absolute; bottom: -60px; right: -60px;
    width: 160px; height: 160px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(184,255,87,0.06) 0%, transparent 70%);
    opacity: 0; transition: all 0.4s;
  }
  .spec-card:hover {
    border-color: rgba(184,255,87,0.2);
    transform: translateY(-6px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.4);
  }
  .spec-card:hover::before { opacity: 1; }
  .spec-card:hover::after { opacity: 1; bottom: -40px; right: -40px; }

  .spec-icon {
    width: 52px; height: 52px;
    border-radius: 14px;
    background: var(--accent-dim);
    border: 1px solid var(--border-accent);
    display: flex; align-items: center; justify-content: center;
    font-size: 22px;
    margin-bottom: 24px;
    transition: all 0.3s;
  }
  .spec-card:hover .spec-icon {
    background: var(--accent);
    border-color: var(--accent);
    transform: scale(1.1) rotate(-5deg);
    filter: drop-shadow(0 0 12px rgba(184,255,87,0.5));
  }
  .spec-card:hover .spec-icon .emoji-filter {
    filter: none;
  }

  .spec-name {
    font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--text-muted); margin-bottom: 8px;
  }
  .spec-value {
    font-family: var(--font-display);
    font-size: 22px; font-weight: 700;
    line-height: 1.2; margin-bottom: 10px;
  }
  .spec-desc { font-size: 14px; color: var(--text-muted); line-height: 1.5; }

  /* PREORDER */
  #preorder { padding: 120px 0; }
  .preorder-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 32px;
    padding: 80px;
    position: relative; overflow: hidden;
    display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;
  }
  .preorder-wrap::before {
    content: '';
    position: absolute; top: -100px; left: -100px;
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(184,255,87,0.06) 0%, transparent 70%);
    pointer-events: none;
  }
  .preorder-wrap::after {
    content: '';
    position: absolute; bottom: -100px; right: -100px;
    width: 300px; height: 300px;
    background: radial-gradient(circle, rgba(0,229,255,0.05) 0%, transparent 70%);
    pointer-events: none;
  }

  .preorder-form-title {
    font-family: var(--font-display);
    font-size: 42px; font-weight: 800;
    line-height: 1.1; letter-spacing: -0.03em;
    margin-bottom: 16px;
  }
  .preorder-form-title span { color: var(--accent); }
  .preorder-form-sub { font-size: 16px; color: var(--text-muted); margin-bottom: 40px; }

  .form-row {
    display: flex; gap: 12px;
    position: relative; z-index: 1;
  }
  .form-input {
    flex: 1;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 16px 24px;
    font-family: var(--font-body);
    font-size: 15px; color: var(--text);
    outline: none;
    transition: all 0.3s;
  }
  .form-input::placeholder { color: var(--text-dim); }
  .form-input:focus {
    border-color: var(--border-accent);
    box-shadow: 0 0 0 3px rgba(184,255,87,0.08);
  }

  .preorder-info { position: relative; z-index: 1; }
  .preorder-features { list-style: none; display: flex; flex-direction: column; gap: 16px; }
  .preorder-features li {
    display: flex; align-items: center; gap: 14px;
    font-size: 15px; color: var(--text-muted);
  }
  .preorder-features li::before {
    content: '✓';
    width: 24px; height: 24px;
    border-radius: 50%;
    background: var(--accent-dim);
    border: 1px solid var(--border-accent);
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; color: var(--accent);
    flex-shrink: 0;
  }
  .preorder-features li span { color: var(--text); }transition: all 0.4s;
    position: relative; overflow: hidden;
    cursor: default;
  }
  .spec-card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0; transition: opacity 0.4s;
  }
  .spec-card::after {
    content: '';
    position: absolute; bottom: -60px; right: -60px;
    width: 160px; height: 160px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(184,255,87,0.06) 0%, transparent 70%);
    opacity: 0; transition: all 0.4s;
  }
  .spec-card:hover {
    border-color: rgba(184,255,87,0.2);
    transform: translateY(-6px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.4);
  }
  .spec-card:hover::before { opacity: 1; }
  .spec-card:hover::after { opacity: 1; bottom: -40px; right: -40px; }

  .spec-icon {
    width: 52px; height: 52px;
    border-radius: 14px;
    background: var(--accent-dim);
    border: 1px solid var(--border-accent);
    display: flex; align-items: center; justify-content: center;
